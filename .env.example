# One-time protected runtime secret: canonical Base64 of 32 random bytes.
# Provisioned for the hosted app. Keep it stable across deployments so saved
# credentials remain readable. Never commit a real key or expose it to clients.
SMS_SETTINGS_ENCRYPTION_KEY=
APP_ORIGIN=https://your-app.example.com

# Background email verification uses a separate protected service endpoint.
# Set the lowercase SHA-256 fingerprint of your service token, never the token.
# Verification uses X-Email-Worker-Token; the campaign worker accepts
# X-Marketing-Worker-Token with the same configured fingerprint.
# On the private Sites host
# it also supplies native service access in OAI-Sites-Authorization.
EMAIL_WORKER_TOKEN_SHA256=

# Email marketing's SMTP relay URL/token and individual SMTP accounts are
# configured in Email marketing > Sending service / SMTP accounts. Credentials
# are encrypted in D1 using SMS_SETTINGS_ENCRYPTION_KEY and never returned.
# Deploy services/smtp-relay on a server with outbound SMTP and HTTPS access.

# Configure your Termii API key, dashboard base URL and live sending directly
# in the app's Provider & settings screen. Those edits apply immediately.
# The API key is stored as authenticated ciphertext scoped to the signed-in owner.

# Optional legacy runtime configuration for existing installations only.
# Owner-specific app settings take precedence, including after disconnect.
# TERMII_API_KEY=
# TERMII_BASE_URL=
# SMS_LIVE_ENABLED=false
