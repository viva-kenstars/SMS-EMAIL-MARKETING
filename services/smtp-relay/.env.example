# Use a public DNS name pointing at this server. Ports 80/443 must reach Caddy.
SMTP_RELAY_HOST=mail-relay.your-domain.com
SMTP_RELAY_PUBLIC_URL=https://mail-relay.your-domain.com
# Generate two DIFFERENT secrets locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SMTP_RELAY_TOKEN=
SMTP_RELAY_SIGNING_KEY=
SMTP_ALLOWED_PORTS=465,587,2525
SMTP_MAX_CONCURRENT=5
# Optional unattended worker. Do not enable until Site runtime hashes are configured.
TREZAD_SITE_URL=
SITE_PLATFORM_TOKEN=
MARKETING_WORKER_TOKEN=
# Optional existing Reoon verifier runner token.
EMAIL_WORKER_TOKEN=
SCHEDULER_INTERVAL_MS=1000
